# =============================================================================
# TIKTOK AUTOMATION - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e configure com suas credenciais
# =============================================================================

# -----------------------------------------------------------------------------
# OPENROUTER (IA GRATUITA)
# -----------------------------------------------------------------------------
# Obtenha sua API key grátis em: https://openrouter.ai/keys
# Com a key grátis, você tem acesso a modelos como Llama 3.3 70B, Gemma 3, etc.
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# TIKTOK
# -----------------------------------------------------------------------------
# SessionID do TikTok - necessário para upload automático
# 
# COMO OBTER:
# 1. Acesse https://www.tiktok.com e faça login
# 2. Pressione F12 (Developer Tools)
# 3. Vá em Application > Cookies > https://www.tiktok.com
# 4. Copie o valor de "sessionid"
# 
# OU use a extensão "Get cookies.txt" no Chrome/Firefox
TIKTOK_SESSIONID=

# -----------------------------------------------------------------------------
# N8N CONFIGURAÇÃO
# -----------------------------------------------------------------------------
# Host onde o n8n estará acessível
N8N_HOST=localhost

# URL para webhooks (use seu domínio se for expor o n8n)
WEBHOOK_URL=http://localhost:5678/

# Chave de encriptação do n8n (mude para segurança!)
# Gere uma com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=n8n-encryption-key-change-me-in-production

# -----------------------------------------------------------------------------
# TELEGRAM (NOTIFICAÇÕES - OPCIONAL)
# -----------------------------------------------------------------------------
# Para receber notificações no Telegram:
# 1. Crie um bot com @BotFather
# 2. Pegue o token
# 3. Descubra seu chat_id com @userinfobot

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES GERAIS
# -----------------------------------------------------------------------------
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE CONTEÚDO
# -----------------------------------------------------------------------------
# Horário de geração (formato 24h)
GENERATE_TIME=09:00

# Horário de postagem (horário de pico)
UPLOAD_TIME=18:00

# Modelo de IA padrão (use modelos :free do OpenRouter)
DEFAULT_IA_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Voz TTS padrão (Edge TTS)
DEFAULT_TTS_VOICE=pt-BR-FranciscaNeural

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE VÍDEO
# -----------------------------------------------------------------------------
# Permitir comentários nos vídeos
ALLOW_COMMENTS=true

# Permitir duetos
ALLOW_DUET=true

# Permitir stitch
ALLOW_STITCH=true

# Marcar como conteúdo IA
AI_LABEL=false

# Privacidade: public, private, friends
VIDEO_PRIVACY=public
